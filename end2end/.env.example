# Admin credentials for the TrailBase fixture: global-setup logs in as
# admin to set the known password and clean up orphaned test accounts.
ORIGA_ADMIN_EMAIL=admin@localhost
ORIGA_ADMIN_PASSWORD=your-admin-password-here

# This is the whole .env contract. The service URLs are derived by the
# harness: TrailBase/CDN/app addresses are built from the ports (shell
# env E2E_TRAILBASE_PORT / E2E_CDN_PORT / E2E_APP_PORT, defaults in
# shots/config.ts), and the app build gets its compile-time TRAILBASE_URL
# / ORIGA_CDN_BASE_URL injected by the Playwright webServer.

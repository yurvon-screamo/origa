# Logs
*.log

# Cache
.cache/

# Internal fix-restore artifacts (status notes from parallel work, not production)
.audio-fix-backup/

# Graphify knowledge graph output
graphify-out/

# Bundled fonts (staged from cdn/fonts/ by build.rs into public/fonts/ for
# trunk copy-dir; cdn/fonts/ is the canonical source, this is a build mirror)
origa_ui/public/fonts/

# Android keystore files
*.keystore

# Android signing
origa-release.keystore

# Whisper ONNX models (large binary files - must be placed manually)
tauri/resources/whisper/encoder_model.onnx
tauri/resources/whisper/decoder_model.onnx

# Whisper local model caches (downloaded from HuggingFace, not needed in repo)
models/whisper-tiny/
models/whisper-tiny-onnx/

# cdn
cdn

# Font source cache (downloaded by scripts/subset_fonts.py)
scripts/.font_cache/

# One-time CDN migration artifacts (Railway → Tigris, executed 2026-08-02)
scripts/.cdn_migration_cache/
scripts/migrate-cdn-log.txt
scripts/t3-migrate-log.txt
# Local staging directory for re-shot store assets (ADR-068): the marketer
# drops the new captures here, `scripts/publish_media.py` uploads them to
# the CDN, and the registry in docs/media/ records the result. The working
# files (and the fonts a store listing may need) never reach a commit.
store-assets/
webdriver.json
.venv-deploy/
.venv/
# worktree symlink to the main checkout's virtualenv (the dir rule above
# does not match symlinks)
scripts/.venv
.pytest_cache/

# Generated by the build-flatpak CI job (ADR-064), never committed
packaging/flatpak/flatpak-manifest.generated.yml
packaging/flatpak/cargo-sources.json

# desloper --setup vendor scanners (AI-slop audit tooling, not shipped)
/vendors/

# cargo-mutants output (weekly-quality runs it locally)
mutants.out/

# Local scratch space of the agent workflow
tmp/

*.flatpak
.opencode/factory/node_modules/
.stitch/
end2end/.stitch/

# Local TrailBase artifact from a stray `trail run` at the worktree root
/traildepot/

# PR review screenshots — uploaded to CDN in reports, never committed
# (binary ballast in git history; see issue #797)
.pr-screenshots/

# Screenshots of the e2e suite — the tool writes them outside the
# repository (the capture tool puts them in /tmp/opencode/shots/), so
# nothing lands in the working tree by accident.
end2end/screenshots/
translator/.venv/

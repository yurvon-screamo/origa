        <intent
            android:action="android.intent.action.VIEW"
            android:data="origa://add?source=audio"
            android:targetPackage="net.uwuwu.origa"
            android:targetClass="net.uwuwu.origa.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="add_text"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_text"
        android:shortcutLongLabel="@string/shortcut_text_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="origa://add?source=text"
            android:targetPackage="net.uwuwu.origa"
            android:targetClass="net.uwuwu.origa.MainActivity" />
    </shortcut>
</shortcuts>

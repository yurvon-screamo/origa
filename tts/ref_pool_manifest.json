[
 {
  "idx": 0,
  "phrase_id": "00000000000C5ARDS6D2BX67Q6",
  "text": "よろしい。素直に謝ったことは評価致しましょう。良いですか、剣丞どの",
  "dur": 7.472125
 },
 {
  "idx": 1,
  "phrase_id": "00000000000CBX93GFWVZ6E6TT",
  "text": "四季ナツメの魂に反応しているのだ。これだけ強く輝くのならば問題はない",
  "dur": 6.871292
 },
 {
  "idx": 2,
  "phrase_id": "00000000001NA57WJ6S7H1XYXF",
  "text": "うん。剣丞の奥さんなら、光璃ちゃんも鞠のお姉ちゃんなの。嬉しいの",
  "dur": 7.550458
 },
 {
  "idx": 3,
  "phrase_id": "00000000002MFX5YBW3MJJ6961",
  "text": "ですが、泡沫でもいい。せめて夢の中では、優しい時間を過ごしたい",
  "dur": 7.524333
 },
 {
  "idx": 4,
  "phrase_id": "00000000002T007KC0TD8GBF1V",
  "text": "うむ。積もる話もあるが、すぐに軍議に出る。夕食の用意を頼むぞ",
  "dur": 6.583958
 },
 {
  "idx": 5,
  "phrase_id": "000000000032P0FMEFH7GK1YDR",
  "text": "背負われるだけなんて…嫌です。わたしも背負いたいですから",
  "dur": 6.139875
 },
 {
  "idx": 6,
  "phrase_id": "000000000037K8V7Z0HXY4NGC9",
  "text": "はいです。味はつばめさんお墨付きですよ。召し上がってください",
  "dur": 6.11375
 },
 {
  "idx": 7,
  "phrase_id": "000000000050VRDW1CN42EGGFV",
  "text": "それはそうなんですが…うーん、こういう家だと、なんか違う気がして",
  "dur": 7.681083
 },
 {
  "idx": 8,
  "phrase_id": "0000000000539P3C0JNXWEKHRE",
  "text": "でもその背後には伊達が居る、か。佐竹も一筋縄ではいかないとは思うけど",
  "dur": 8.856583
 },
 {
  "idx": 9,
  "phrase_id": "00000000005YQ9ER1K9Y0J11X7",
  "text": "どこかで見たことがある気がするんだけど…うーん",
  "dur": 8.987208
 },
 {
  "idx": 10,
  "phrase_id": "0000000000616H95Q5YJBP68WK",
  "text": "ん、偉い偉い…ホントーに偉いよぉ",
  "dur": 7.028042
 },
 {
  "idx": 11,
  "phrase_id": "00000000007HNN8JX3TJXWQYR1",
  "text": "そしてボクたちの体を小さく分割していけば、必ずその全てが量子粒子になる",
  "dur": 7.315375
 },
 {
  "idx": 12,
  "phrase_id": "00000000007HTDP9GWSCMXRKQE",
  "text": "ええ…そうね。空は大切な子よ。それこそ、私の娘にしたいくらいに",
  "dur": 7.785583
 },
 {
  "idx": 13,
  "phrase_id": "00000000007M5KWQ42AY8QR1X1",
  "text": "あー、はいはい。じゃあ次は伊豆と相模に分散している鬼を集めておきなさい",
  "dur": 6.374958
 },
 {
  "idx": 14,
  "phrase_id": "00000000007NZ3HGEMFT95VAS7",
  "text": "そうしてなんでも自分たちだけの問題にするのはガキの悪い癖だ",
  "dur": 7.001917
 },
 {
  "idx": 15,
  "phrase_id": "00000000007X16Q5DRZ6YR26WH",
  "text": "皆、聡い。この戦が日の本の未来に通じることを、充分に分かっています",
  "dur": 6.557833
 },
 {
  "idx": 16,
  "phrase_id": "000000000081GVFA4MMMTWTJ14",
  "text": "ワタシもお手伝いします。引札配りなら、万屋りんちゃんにお任せです",
  "dur": 6.139875
 },
 {
  "idx": 17,
  "phrase_id": "000000000082BQV30Z9W7D7XMJ",
  "text": "さきほどのキスだって、一人で何度か試したことがありまして",
  "dur": 6.348833
 },
 {
  "idx": 18,
  "phrase_id": "00000000008TRWX8JY8GCSHHAT",
  "text": "本人に言えないようなことは、そもそも口にしない。陰口はよくないよ",
  "dur": 5.983125
 },
 {
  "idx": 19,
  "phrase_id": "000000000092STHQE6QNC7PBEY",
  "text": "ん～、うるちゃいですよ。ほら、こうして黙らせちゃいます",
  "dur": 8.229667
 },
 {
  "idx": 20,
  "phrase_id": "00000000009WBVAWDRBTW56FAY",
  "text": "はい、神社はすごく大きな木があるので、すぐわかるって",
  "dur": 8.438625
 },
 {
  "idx": 21,
  "phrase_id": "00000000009Y97VCFKV6X387MB",
  "text": "私はお手伝いできます。あの、予定も特にない…です",
  "dur": 6.714542
 },
 {
  "idx": 22,
  "phrase_id": "0000000000A1BGSF588HEFPHMF",
  "text": "ふふっ。当ててるのよ。競争相手も多いから、これくらいしないとね",
  "dur": 7.550458
 },
 {
  "idx": 23,
  "phrase_id": "0000000000A5D5118JFNJNXTDB",
  "text": "打ち合って、勝ち、喜ぶ、という語呂と掛けてあるのだがな",
  "dur": 5.90475
 },
 {
  "idx": 24,
  "phrase_id": "0000000000AHQ8ACC72B5X6DF1",
  "text": "ん、大丈夫。ほとんど、痛くない。ちょっとだけ、だから",
  "dur": 12.017417
 },
 {
  "idx": 25,
  "phrase_id": "0000000000AS6MPR6T4WS6E0N9",
  "text": "っていうのもおかしいですね。これから自分が通うクラスになるわけですし",
  "dur": 6.531708
 },
 {
  "idx": 26,
  "phrase_id": "0000000000B78SVYHGY6RX7P5C",
  "text": "せんぱいの…飲んじゃいました",
  "dur": 6.479458
 },
 {
  "idx": 27,
  "phrase_id": "0000000000BDJMCD9NZA5WJQ84",
  "text": "いえ別に。最近は誰も相手してくれないから暇なんですよねー",
  "dur": 6.270458
 },
 {
  "idx": 28,
  "phrase_id": "0000000000C6YFZRN6NRZFD2VA",
  "text": "はい。あのですね…綾那が、どうしても剣丞さまにご用があるそうで",
  "dur": 8.752125
 },
 {
  "idx": 29,
  "phrase_id": "0000000000CJVWFYMAR5Z3ZZBH",
  "text": "しかも彦五郎殿と言えば、今川家の現当主ではありませんか",
  "dur": 7.237
 },
 {
  "idx": 30,
  "phrase_id": "0000000000D2GNC6H26D0RS3X7",
  "text": "で、これらの味を加味した店全体の評価が―３０点",
  "dur": 6.322708
 },
 {
  "idx": 31,
  "phrase_id": "0000000000DFKANSNY75BXQENX",
  "text": "ふふっ、いい子です。なら",
  "dur": 8.543125
 },
 {
  "idx": 32,
  "phrase_id": "0000000000E157SQJSMTJE0S27",
  "text": "お料理対決で約束したはずよね。長屋でアレコレしても口を出さないって",
  "dur": 8.987208
 },
 {
  "idx": 33,
  "phrase_id": "0000000000E7WQ0R5WCQTF30Y5",
  "text": "ああ、嬉しいです。こんなわたしを受け入れてくださって",
  "dur": 7.759458
 },
 {
  "idx": 34,
  "phrase_id": "0000000000EE8EE5EAFDWHZW3Y",
  "text": "何度断られようが、どんなに時間が経とうが、オレの気持ちは変わらん",
  "dur": 6.583958
 },
 {
  "idx": 35,
  "phrase_id": "0000000000ETNSWNYN5CXQ25MR",
  "text": "いいじゃねぇか。真影流の剣、見せてやろうぜ",
  "dur": 6.348833
 },
 {
  "idx": 36,
  "phrase_id": "0000000000FN614WD7AQFXBRA2",
  "text": "これで兄さんはわたしだけのものです。わたしも兄さんだけの妹",
  "dur": 8.490875
 },
 {
  "idx": 37,
  "phrase_id": "0000000000FQ5TM3VM0ZRE1YYS",
  "text": "でもそういう仕事ほど引き受けちゃうんだろうね。剣丞さま真面目だから",
  "dur": 6.139875
 },
 {
  "idx": 38,
  "phrase_id": "0000000000FQ7S5ASY767P8FXS",
  "text": "ずっと見てたの。ナツメの働く姿と、友達と楽しそうにしてるところを",
  "dur": 6.244333
 },
 {
  "idx": 39,
  "phrase_id": "0000000000FV9RXFWE9C3PWCAF",
  "text": "ううん。要確認だと思うの。だって、ラブコメが目的なんだよ",
  "dur": 6.035375
 },
 {
  "idx": 40,
  "phrase_id": "0000000000G0AV38JZP1H1TR21",
  "text": "いえ、これがあの、誰もが畏れていた魔神アンゴルモアなのかと思いまして",
  "dur": 6.322708
 },
 {
  "idx": 41,
  "phrase_id": "0000000000GADC3B7XAD06PX8V",
  "text": "それに、これ以上はどうすればいいのかも…わからない",
  "dur": 7.890083
 },
 {
  "idx": 42,
  "phrase_id": "0000000000GMJ34KEN1S7T07WJ",
  "text": "知恵をつけたのでしょう。ただの鬼よりも動き方に秩序が見えています",
  "dur": 7.1325
 },
 {
  "idx": 43,
  "phrase_id": "0000000000GYTEXM81Z6N58HMD",
  "text": "はじめまして、ボクは加賀美ヒカル、こっちは姉のヘキルだよ。よろしく瑞穂",
  "dur": 7.550458
 },
 {
  "idx": 44,
  "phrase_id": "0000000000H6Q0R632GEHM8J80",
  "text": "理由はいくつか考えられますが…私も詩乃も、結局は同じ答えに至りました",
  "dur": 6.374958
 },
 {
  "idx": 45,
  "phrase_id": "0000000000HXTMVR140TXS6FB2",
  "text": "なるほど。荷車を倒して柵とする、か。良い策であるな。柵だけに",
  "dur": 7.602708
 },
 {
  "idx": 46,
  "phrase_id": "0000000000JK1HCMDNN17ZDNBH",
  "text": "あとは…自分たちが目標の二人に信用されることが必要だけど",
  "dur": 6.427208
 },
 {
  "idx": 47,
  "phrase_id": "0000000000JM00QAB5ZBAY076D",
  "text": "で、仕事の方は…このまま店で働けばいいとして。一番の問題は住居だ",
  "dur": 8.987208
 },
 {
  "idx": 48,
  "phrase_id": "0000000000JT3MZBK5B358F5WE",
  "text": "あ、工場が見えてきたよ景くん。あの子達の自転車は",
  "dur": 8.334167
 },
 {
  "idx": 49,
  "phrase_id": "0000000000M8WKREC65ZDYXN44",
  "text": "それなら、嬉しいです…あら、嬉しいですわん",
  "dur": 6.192125
 },
 {
  "idx": 50,
  "phrase_id": "0000000000MFZC089T1QJXY2EH",
  "text": "初めてで上手くできるか不安でしたが。喜んでもらえて嬉しいです",
  "dur": 6.401083
 },
 {
  "idx": 51,
  "phrase_id": "0000000000MP05H875JHKPKFPQ",
  "text": "けど、彩乃ちゃんに引き替え、あなたは。こっちが驚くくらい上達しないわね",
  "dur": 7.315375
 },
 {
  "idx": 52,
  "phrase_id": "0000000000NDTK0JEDWSKDZKB0",
  "text": "あ、愛する旦那さまのために、万屋りんちゃん頑張るです",
  "dur": 7.001917
 },
 {
  "idx": 53,
  "phrase_id": "0000000000P25BPBPJFQME1KSD",
  "text": "そうだ。我らに加勢し、我らに仇なす全てを滅ぼす力を得る必要があったのだ",
  "dur": 8.699875
 },
 {
  "idx": 54,
  "phrase_id": "0000000000P5WF9AZK2W93174Z",
  "text": "疲れたならば茶を立ててやろう。苦しいならば肩を抱いてやろう。",
  "dur": 9.013333
 },
 {
  "idx": 55,
  "phrase_id": "0000000000P929RD9VBMMN6E57",
  "text": "そうねぇ…えへへ、でも肩までじゃここはあたたまりきらないから",
  "dur": 8.177417
 },
 {
  "idx": 56,
  "phrase_id": "0000000000PAX1WCP6258JA5NR",
  "text": "そういうことは毎日なにかしらの料理をしてる人間だけが言っていいことなの",
  "dur": 6.11375
 },
 {
  "idx": 57,
  "phrase_id": "0000000000PPK3S60SR249AP1Y",
  "text": "せっかく高嶺さんの魂にいい影響が出ているのに、それでは本末転倒ですよ",
  "dur": 6.505583
 },
 {
  "idx": 58,
  "phrase_id": "0000000000PQ9A9XT230CRV2J3",
  "text": "殴り込む勢いで、新本橋へやって来た右京。果たして、そこで見たものは",
  "dur": 7.001917
 },
 {
  "idx": 59,
  "phrase_id": "0000000000PWK1F7TNCJT28GWC",
  "text": "だったら、ショックがおさまるまで。肉体が安定するまで。私が魂を補えば",
  "dur": 7.446
 },
 {
  "idx": 60,
  "phrase_id": "0000000000PZWSA2HD191FM3ZQ",
  "text": "さて…織田を中心とする、浅井・松平・足利・松永を含む畿内連合",
  "dur": 8.203542
 },
 {
  "idx": 61,
  "phrase_id": "0000000000Q03ZZ6BCKP4J3K7G",
  "text": "に、錦です。後にも先にも右も左もわかりません",
  "dur": 6.270458
 },
 {
  "idx": 62,
  "phrase_id": "0000000000QFR88VP0KGW11FTZ",
  "text": "だから、その、キスの、先…とか",
  "dur": 8.125167
 },
 {
  "idx": 63,
  "phrase_id": "0000000000QJCBDVEBNZJA19X2",
  "text": "ん…そういえば、最初に見た時よりも膨らんでいるような",
  "dur": 7.890083
 },
 {
  "idx": 64,
  "phrase_id": "0000000000QMVM9H9EXF8N4HR1",
  "text": "そうだね、スーミン。あの二人を見てると心がすさんでいくよ",
  "dur": 6.479458
 },
 {
  "idx": 65,
  "phrase_id": "0000000000QTAV9H4K48445F62",
  "text": "だから、もっと酷いことしてよ。魔神らしく悪いことしてよ",
  "dur": 6.505583
 },
 {
  "idx": 66,
  "phrase_id": "0000000000RR6WF9T2WGXR2PX4",
  "text": "邪魔しちゃ悪いと思ったけど、さすがに止めさせてもらうわ。まだお昼よ",
  "dur": 6.505583
 },
 {
  "idx": 67,
  "phrase_id": "0000000000RTGCA2DJJ2TEKM85",
  "text": "お父さんとお母さん、朝はパン派。お米派のわたしとは趣味が合わないから",
  "dur": 5.721917
 },
 {
  "idx": 68,
  "phrase_id": "0000000000T9WSWRE6VD2WTBBJ",
  "text": "まあ、いいわ。これだけ広がっていると、口止めする意味もあまりないしね",
  "dur": 5.957
 },
 {
  "idx": 69,
  "phrase_id": "0000000000TBCJ6B8FPEC084BH",
  "text": "なに言ってんですか、背が高くて、スタイルも良いし、うらやましーですよ",
  "dur": 5.826375
 },
 {
  "idx": 70,
  "phrase_id": "0000000000W79AB582QC4YKNF3",
  "text": "小夜叉…純粋に生き、誰に恥じることなく、死んでいけ",
  "dur": 7.890083
 },
 {
  "idx": 71,
  "phrase_id": "0000000000WFNZN5F0X6BREJ3H",
  "text": "さあ…けど、女の子が変わる原因なんて、そう多くは無いと思う",
  "dur": 7.994542
 },
 {
  "idx": 72,
  "phrase_id": "0000000000XH1268KH6VB0BD4C",
  "text": "向島さんの放送、ひと段落したみたいですね。次はこちらの番です",
  "dur": 6.845167
 },
 {
  "idx": 73,
  "phrase_id": "0000000000XM39BGNPGPFB7BN7",
  "text": "また、自然災害や疫病も宗教と大きく関わりを持ちます。えー、猫天宮さん",
  "dur": 9.274542
 },
 {
  "idx": 74,
  "phrase_id": "0000000000XVA81QVVHMP5N15G",
  "text": "まあ、昂晴君、ウチの希も本当の巫女じゃ無いけど家庭的な良い娘だよ",
  "dur": 7.106375
 },
 {
  "idx": 75,
  "phrase_id": "0000000000YN4DCTBXTAFM0QNV",
  "text": "ですよね。ずっと一緒に暮らしてきたんですもん。そんなはずありませんよね",
  "dur": 7.994542
 },
 {
  "idx": 76,
  "phrase_id": "0000000000Z033JXK0XA2M4TFW",
  "text": "ねえねえ、ゆうくん。この前言ってた勉強会なんだけど",
  "dur": 6.923542
 },
 {
  "idx": 77,
  "phrase_id": "0000000000Z17RZH96HZQ43PS4",
  "text": "それは勘弁してくださいよー。せっかく今日のために覚えたのに",
  "dur": 6.270458
 },
 {
  "idx": 78,
  "phrase_id": "0000000000ZMPG3SSD478WKETM",
  "text": "おじさんはおじさんだから、おじさんなんだよ。リコは自分を曲げないよ",
  "dur": 6.819042
 },
 {
  "idx": 79,
  "phrase_id": "0000000000ZVVYP62ZN9FF0TPV",
  "text": "そうですね。今日の仕事で、剣丞さまの承認が必要な案件は片付いていますし",
  "dur": 7.49825
 }
]